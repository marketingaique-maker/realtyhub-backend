  <nav class="admin-nav" aria-label="Admin navigation">
    <a href="dashboard.html" data-icon="⌂"><span>Dashboard</span></a>
    <a href="properties.html" data-icon="▦"><span>Properties</span></a>
    <a href="vehicles.html" data-icon="◇"><span>Vehicles</span></a>
